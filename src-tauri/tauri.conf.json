{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Lens",
  "version": "0.2.0",
  "identifier": "com.bartlomiejzimny.disk-lens",
  "build": {
    "beforeDevCommand": "node_modules/.bin/vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node_modules/.bin/tsc -b && node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Disk Lens",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Analizator zajętości dysku",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
